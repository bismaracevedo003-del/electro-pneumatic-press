# Optional real-mode configuration for the electro-pneumatic press.
# Copy to .env and export the variables you need. .env is gitignored.
# Leave MODE=simulation to keep the existing simulator and tests unchanged.
MODE=simulation
REAL_STRICT=true
LOG_LEVEL=INFO

# The press adapter is ALWAYS read-only. ALLOW_WRITES=true is rejected.
ALLOW_WRITES=false

# Required when MODE=real (replace placeholders with real plant values).
S7_HOST=<PLC_IP_ADDRESS>
S7_PORT=102
S7_RACK=<RACK_NUMBER>
S7_SLOT=<SLOT_NUMBER>

# Optional partial override of the S7 tag map (JSON, tag -> AREA:byte[.bit]).
# S7_ADDRESS_MAP={"Button1":"I:0.0","GuardClosed":"I:0.3","State":"M:2"}
